{
  "name": "risk-gate",
  "version": "1.0.0",
  "description": "🚦 操作风险检测 MCP Server - 实时检测 SQL、Shell 命令、API 调用等操作风险",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "risk-gate": "./build/index.js"
  },
  "scripts": {
